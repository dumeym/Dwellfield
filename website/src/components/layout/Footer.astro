---
const year = new Date().getFullYear();
---
<footer class="border-t border-line bg-bone"><div class="mx-auto max-w-[1400px] px-6 py-14 lg:px-10">
  <div class="grid gap-8 md:grid-cols-2"><div><p class="font-display text-4xl font-semibold tracking-[-.035em]">Dwellfield</p><p class="mt-4 max-w-[410px] text-sm leading-relaxed text-ink-3">A considered secondary dwelling for Queensland backyards.</p></div><div class="flex flex-wrap gap-x-7 gap-y-3 md:justify-end">{["The home","Design","Price & inclusions","FAQs"].map((label, i) => <a class="font-mono text-[10px] uppercase tracking-[.12em] text-ink-3 hover:text-ink" href={["/#home","/#design","/#pricing","/#faq"][i]}>{label}</a>)}</div></div>
  <div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 font-mono text-[10px] uppercase tracking-[.1em] text-ink-3 md:flex-row md:justify-between"><p>© {year} Dwellfield</p><div class="flex gap-6"><a href="/privacy/" class="hover:text-ink">Privacy</a><p>Queensland, Australia</p></div></div>
</div></footer>
