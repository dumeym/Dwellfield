---
import PageLayout from "~/layouts/PageLayout.astro";
---

<PageLayout title="Thank you | Dwellfield" description="Thank you for contacting Dwellfield about a secondary dwelling in Queensland.">
  <section class="flex min-h-[68vh] items-center bg-bone px-6 py-24 lg:px-10">
    <div class="mx-auto w-full max-w-[1050px]">
      <p class="eyebrow mb-8 text-brass-2">Enquiry received</p>
      <h1 class="max-w-[850px] font-display text-[clamp(4rem,9vw,8.5rem)] leading-[.88] tracking-[-.035em]">Thank you for<br /><em>getting in touch.</em></h1>
      <p class="mt-9 max-w-[570px] text-lg leading-relaxed text-ink-3">We’ll review your enquiry and reply using the email address you provided. In the meantime, you can revisit the home and its indicative details.</p>
      <a href="/" class="mt-10 inline-block border-b border-ink pb-2 font-mono text-[11px] uppercase tracking-[.14em]">Back to Dwellfield ↗</a>
    </div>
  </section>
</PageLayout>
