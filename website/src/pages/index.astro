---
import PageLayout from "~/layouts/PageLayout.astro";
import ResponsiveImage from "~/components/media/ResponsiveImage.astro";
import HomeSpecIcon from "~/components/media/HomeSpecIcon.astro";
const images = "/images/";
const homeSpecs = [
  { kind: "living", label: "Living" },
  { kind: "dining", label: "Dining" },
  { kind: "kitchen", label: "Kitchen" },
  { kind: "bathroom", label: "Bathroom" },
  { kind: "bedroom", label: "Bedroom" },
] as const;
const steps = [
  ["01", "Tell us about your block", "Share your suburb, intended use and a few details about your backyard."],
  ["02", "Review the site", "A local professional checks access, services, site constraints and the approval pathway."],
  ["03", "Set the scope", "We confirm the design, inclusions, optional extras and a site-specific quotation."],
  ["04", "Prepare and assemble", "Precision-made components arrive after site preparation. Local trades complete assembly, connections and inspections."],
];
const faqs = [
  ["Can I build without approval in Queensland?", "A new secondary dwelling needs building approval. Whether a development application is also needed depends on the council, zoning and site. We start with a site review rather than assume every block follows the same pathway."],
  ["Could I rent it out?", "Queensland removed the state-wide restriction that limited secondary dwellings to family members. Your site and intended use still need to be checked; renting can also trigger additional fire safety and sound transmission requirements under the building code."],
  ["Is it a separate property title?", "This home is planned as a secondary dwelling on the same lot as the main house. It is not offered as a separately titled property. Any subdivision would be a different proposal requiring its own assessment."],
  ["Is the timber deck included?", "No. The 2 m × 4 m pale timber deck shown in the exterior visual is an optional extra. An awning and selected accessories can also be quoted separately."],
  ["How long will it take?", "We are designing for a short on-site assembly period. Total timing also includes site assessment, approvals, manufacturing, shipping, groundworks and final inspections. We will publish a reliable assembly timeframe after a Queensland installation has been completed and measured."],
  ["Is $150,000 a fixed price?", "$150,000 is our current indicative target, not a fixed offer. We expect it to cover GST, a standard foundation, approvals, freight, local installation and most service connections. Site conditions and local requirements may change the final price."],
];
---

<PageLayout title="Dwellfield | Secondary dwellings for Queensland" description="Explore Dwellfield: a warm, self-contained secondary dwelling planned for Queensland backyards, with indicative pricing and a site review pathway.">
  <section class="relative overflow-hidden bg-ink text-bone md:min-h-[calc(100svh-4rem)]" id="top" aria-label="Introduction">
    <picture class="block w-full md:absolute md:inset-0 md:h-full">
      <source media="(max-width: 767px)" srcset="/images/hero-mobile-760.webp 760w, /images/hero-mobile.webp 1122w" sizes="100vw" />
      <ResponsiveImage name="hero-deck" class="block aspect-square h-auto w-full object-cover md:aspect-auto md:h-full md:object-[53%_center]" alt="Artist's impression of the whole warm timber-look backyard home, with one glazed door on the left, a window on the right and an optional pale timber deck" priority />
    </picture>
    <div class="hidden md:absolute md:inset-0 md:block md:bg-gradient-to-r md:from-[#151712]/75 md:via-[#151712]/35 md:to-transparent"></div>
    <div class="relative mx-auto flex max-w-[1400px] flex-col justify-end px-6 pb-12 pt-11 md:min-h-[calc(100svh-4rem)] md:pb-16 md:pt-32 lg:px-10 lg:pb-24">
      <p class="mb-7 font-mono text-[11px] tracking-[.22em] uppercase text-bone/80" data-reveal>A considered secondary dwelling for Queensland</p>
      <h1 class="max-w-[950px] font-display text-[clamp(3.4rem,10.5vw,10rem)] leading-[.82] tracking-[-.035em]" data-reveal>More room<br /><em class="font-normal">for living.</em></h1>
      <div class="mt-9 flex max-w-[750px] flex-col gap-8 md:flex-row md:items-end md:justify-between" data-reveal>
        <p class="max-w-[450px] text-base leading-relaxed text-bone/90 md:text-lg">A complete, considered home in the backyard you already own. Made for family now, with possibilities for the years ahead.</p>
        <div class="flex shrink-0 flex-wrap items-center gap-5">
          <a href="#enquire" class="border border-bone px-5 py-3 font-mono text-[11px] uppercase tracking-[.13em] transition-colors hover:bg-bone hover:text-ink">Order &amp; know more ↗</a>
          <a href="#home" class="whitespace-nowrap border-b border-bone pb-2 font-mono text-[11px] tracking-[.14em] uppercase hover:text-[#e4c492]">Explore the home ↓</a>
        </div>
      </div>
      <p class="mt-9 font-mono text-[10px] tracking-[.08em] text-bone/75 md:absolute md:bottom-5 md:left-6 md:mt-0 lg:left-10">Artist’s impression · Optional timber deck shown</p>
    </div>
  </section>

  <div class="border-b border-line bg-bone" aria-label="Home at a glance">
    <div class="mx-auto max-w-[1400px] px-6 py-8 lg:px-10 lg:py-10">
      <div class="flex flex-col gap-3 border-b border-line pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div><p class="font-mono text-[10px] uppercase tracking-[.16em] text-brass-2">Dwellfield / At a glance</p><p class="mt-2 font-display text-[clamp(2.4rem,5vw,4.5rem)] leading-none tracking-[-.03em]">Approx. 60 m²</p></div>
        <p class="max-w-[330px] text-xs leading-relaxed text-ink-3">Planned product size. The indicative Model B floor plan shown below has a 54 m² external footprint; final sales dimensions are to be confirmed.</p>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-6 pt-7 sm:grid-cols-3 lg:grid-cols-5 lg:gap-5">
        {homeSpecs.map(({ kind, label }) => <div class="flex items-center gap-3 text-ink"><HomeSpecIcon kind={kind} /><span class="font-display text-[25px] leading-none">1 <span class="text-[19px]">{label}</span></span></div>)}
      </div>
    </div>
  </div>

  <section class="mx-auto grid max-w-[1400px] gap-12 px-6 py-24 md:grid-cols-[.9fr_1.1fr] md:gap-20 lg:px-10 lg:py-36" id="home">
    <div><p class="eyebrow mb-7 text-brass-2">01 / A home in its own right</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.92] tracking-[-.03em]">A little more space.<br /><em>A lot more life.</em></h2></div>
    <div class="max-w-[650px] self-end"><p class="text-xl leading-[1.5] text-ink-2 md:text-2xl">Close enough to feel connected. Separate enough to feel at home.</p><p class="mt-7 max-w-[540px] text-base leading-relaxed text-ink-3">A self-contained living space with its own kitchen, bathroom, bedroom and room to settle in, planned as a permanent secondary dwelling through the applicable approval pathway. It could bring parents closer, give an adult child a place of their own, or offer rental potential where the site and approvals allow.</p><a href="#layout" class="mt-8 inline-block border-b border-ink pb-2 font-mono text-[11px] tracking-[.14em] uppercase">See the layout ↗</a></div>
  </section>

  <section class="bg-[#e9e3d7] py-6 md:py-10" aria-label="Living space"><div class="mx-auto max-w-[1400px] px-6 lg:px-10">
    <div class="relative overflow-hidden"><ResponsiveImage name="living" alt="Styled concept of the prototype living area with sofa, dining table and greenery" class="block h-[430px] w-full object-cover md:h-[730px]" sizes="(min-width: 1400px) 1320px, 100vw" /><span class="absolute bottom-4 left-4 bg-bone/95 px-3 py-2 font-mono text-[10px] uppercase tracking-[.1em] text-ink md:bottom-6 md:left-6">Styled visualisation based on prototype</span></div>
    <div class="mt-5 flex flex-col justify-between gap-3 md:flex-row"><p class="font-display text-3xl italic md:text-4xl">The everyday, beautifully considered.</p><p class="max-w-[420px] text-sm leading-relaxed text-ink-3">Furniture and styling are illustrative. The images show our design intent and will be checked against the final sales specification.</p></div>
  </div></section>

  <section class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10 lg:py-32" id="possibilities">
    <div class="grid gap-12 md:grid-cols-[.9fr_1.1fr] md:gap-20">
      <div><p class="eyebrow mb-7 text-brass-2">Make more of your block</p><h2 class="font-display text-[clamp(3.2rem,5.6vw,6rem)] leading-[.9] tracking-[-.03em]">The potential<br /><em>in your backyard.</em></h2></div>
      <p class="max-w-[540px] self-end text-lg leading-relaxed text-ink-3">Put underused backyard space to better use: make room for family, give an adult child independence, or explore long-term rental where the site allows.</p>
    </div>
    <div class="mt-16 grid border-t border-line md:grid-cols-3">
      <article class="border-b border-line py-8 md:border-r md:px-7 md:first:pl-0"><span class="font-mono text-[11px] uppercase tracking-[.15em] text-brass-2">01 / For family</span><h3 class="mt-8 font-display text-4xl leading-none">Close by,<br /><em>with privacy.</em></h3><p class="mt-6 max-w-[340px] text-sm leading-relaxed text-ink-3">Give a parent their own entrance and daily routine, with family close at hand.</p></article>
      <article class="border-b border-line py-8 md:border-r md:px-7"><span class="font-mono text-[11px] uppercase tracking-[.15em] text-brass-2">02 / For an adult child</span><h3 class="mt-8 font-display text-4xl leading-none">A place<br /><em>of their own.</em></h3><p class="mt-6 max-w-[340px] text-sm leading-relaxed text-ink-3">A complete place to live as they take their next step, close to the people who matter.</p></article>
      <article class="border-b border-line py-8 md:px-7 md:last:pr-0"><span class="font-mono text-[11px] uppercase tracking-[.15em] text-brass-2">03 / For long-term rental</span><h3 class="mt-8 font-display text-4xl leading-none">An income<br /><em>option.</em></h3><p class="mt-6 max-w-[340px] text-sm leading-relaxed text-ink-3">Explore rental income where the site, approvals and building requirements allow.</p></article>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10 lg:py-36" id="design">
    <div class="grid gap-12 md:grid-cols-2 md:items-end"><div><p class="eyebrow mb-7 text-brass-2">02 / Inside the home</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.9] tracking-[-.03em]">Warmth in<br /><em>the details.</em></h2></div><p class="max-w-[450px] text-base leading-relaxed text-ink-3">The material palette brings together light, calm surfaces, warm timber tones and dark accents. Thoughtful proportions make a compact home feel composed rather than temporary.</p></div>
    <div class="mt-14 grid gap-6 md:grid-cols-12 md:gap-8">
      <figure class="md:col-span-7"><ResponsiveImage name="kitchen-dining" alt="Styled concept of the prototype's kitchen and dining area" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 768px) 60vw, 100vw" /><figcaption class="mt-3 flex justify-between font-mono text-[10px] uppercase tracking-[.12em] text-ink-3"><span>Open living / Dining / Kitchen</span><span>01</span></figcaption></figure>
      <figure class="md:col-span-5 md:pt-28"><ResponsiveImage name="kitchen-detail" alt="Close view of the curved dining table, dark timber-look trim and kitchen cabinetry" class="aspect-[4/5] w-full object-cover" sizes="(min-width: 768px) 40vw, 100vw" /><figcaption class="mt-3 flex justify-between font-mono text-[10px] uppercase tracking-[.12em] text-ink-3"><span>Material detail</span><span>02</span></figcaption></figure>
      <figure class="md:col-span-5 md:pt-16"><ResponsiveImage name="bathroom-detail" alt="Close view of the prototype bathroom's timber-look vanity, white basin and black tap" class="aspect-[4/5] w-full object-cover" sizes="(min-width: 768px) 40vw, 100vw" /><figcaption class="mt-3 flex justify-between font-mono text-[10px] uppercase tracking-[.12em] text-ink-3"><span>Bathroom detail</span><span>03</span></figcaption></figure>
      <figure class="md:col-span-7"><ResponsiveImage name="bedroom" alt="Styled concept of a bedroom with a dark timber-look feature wall and a leafy outlook" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 768px) 60vw, 100vw" /><figcaption class="mt-3 flex justify-between font-mono text-[10px] uppercase tracking-[.12em] text-ink-3"><span>A room of your own</span><span>04</span></figcaption></figure>
    </div>
    <p class="mt-8 max-w-[700px] text-xs leading-relaxed text-ink-3">Styled visualisations based on prototype photographs. Furniture, plants, soft furnishings and garden views are illustrative; final fixtures and finishes are subject to the sales specification.</p>
  </section>

  <section class="bg-ink text-bone" id="layout">
    <div class="mx-auto grid max-w-[1400px] gap-14 px-6 py-24 md:grid-cols-[.82fr_1.18fr] md:items-center lg:px-10 lg:pt-32 lg:pb-20">
      <div><p class="mb-7 font-mono text-[11px] uppercase tracking-[.16em] text-[#caa77b]">03 / The layout</p><h2 class="font-display text-[clamp(2.8rem,5.2vw,5.3rem)] leading-[.9] tracking-[-.03em]">A complete home,<br /><em>with more<br /> possibilities.</em></h2><p class="mt-8 max-w-[420px] leading-relaxed text-bone/70">An indicative one-bedroom layout gives living, cooking and sleeping their own considered places. Final dimensions and configuration will be confirmed before sale.</p><p class="mt-6 text-sm text-bone/60">Its own entrance, kitchen and bathroom make it a self-contained place to live: for you or family, with long-term rental potential where the site and approvals allow.</p></div>
      <div class="bg-[#f4f1ea] p-4 md:p-8"><img src={images+"layout-study.svg"} alt="Indicative Model B floor plan with an open-plan living, dining and kitchen zone, bathroom, bedroom, approximate room dimensions and optional deck" class="w-full" loading="lazy" /><p class="mt-4 font-mono text-[10px] uppercase tracking-[.1em] text-ink-3">Model B prototype · 54 m² external footprint · Indicative dimensions · Deck optional</p></div>
    </div>
    <figure class="mx-auto grid max-w-[1400px] gap-7 px-6 pb-24 md:grid-cols-[1.4fr_.6fr] md:items-end lg:px-10 lg:pb-32">
      <ResponsiveImage name="living-to-kitchen" alt="Styled view from the living area across the dining and kitchen spaces towards the bedroom hallway" class="aspect-[3/2] w-full object-cover" sizes="(min-width: 768px) 70vw, 100vw" />
      <figcaption class="border-t border-bone/30 pt-5 md:pb-2"><span class="font-mono text-[10px] uppercase tracking-[.14em] text-[#caa77b]">A view through the home</span><p class="mt-6 max-w-[350px] font-display text-4xl leading-none md:text-5xl">Open where it matters.<br /><em>Private where it counts.</em></p><p class="mt-7 max-w-[340px] text-sm leading-relaxed text-bone/60">A styled concept showing the relationship between the living area, kitchen and bedroom hallway. Final room positions, fixtures and finishes remain subject to the approved plan and sales specification.</p></figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10 lg:py-36" id="exterior"><div class="grid gap-14 md:grid-cols-2"><div><p class="eyebrow mb-7 text-brass-2">04 / A considered exterior</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.9] tracking-[-.03em]">One calm<br /><em>expression.</em></h2></div><div class="max-w-[550px] self-end"><p class="text-xl leading-relaxed text-ink-2">A warm timber appearance, designed to sit naturally in the garden.</p><p class="mt-6 leading-relaxed text-ink-3">The planned standard exterior uses timber-look aluminium cladding over a light steel structure. The exterior finish is a single considered choice; the pale timber deck, awning and selected accessories are optional extras.</p></div></div><div class="mt-14 grid gap-5 border-y border-line py-7 font-mono text-[11px] uppercase tracking-[.12em] text-ink-3 md:grid-cols-3"><p>Standard exterior<br /><strong class="mt-2 block font-sans text-lg font-normal normal-case tracking-normal text-ink">Warm timber-look aluminium</strong></p><p>Structure<br /><strong class="mt-2 block font-sans text-lg font-normal normal-case tracking-normal text-ink">Light steel frame</strong></p><p>Optional extras<br /><strong class="mt-2 block font-sans text-lg font-normal normal-case tracking-normal text-ink">Deck, awning & accessories</strong></p></div><p class="mt-5 text-xs leading-relaxed text-ink-3">The exterior visual is an artist’s impression. Landscaping and decorative lighting are illustrative. Final colour, cladding profile, openings and specifications require confirmation against the production drawings and sample materials.</p></section>

  <section class="relative overflow-hidden bg-ink" aria-label="Evening exterior impression">
    <ResponsiveImage name="blue-hour" class="block h-[460px] w-full object-cover object-[55%_center] md:h-[760px]" alt="Blue-hour artist's impression of the home with one entrance on the left, a right-hand window and optional pale timber deck" sizes="100vw" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/65 via-transparent to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 mx-auto flex max-w-[1400px] flex-col gap-4 px-6 pb-9 text-bone md:flex-row md:items-end md:justify-between lg:px-10">
      <p class="max-w-[640px] font-display text-[clamp(2.7rem,5vw,5.5rem)] leading-[.95]">A place that belongs<br /><em>in the garden.</em></p>
      <p class="max-w-[270px] font-mono text-[10px] uppercase leading-relaxed tracking-[.08em] text-bone/80">Artist’s impression<br />Optional deck shown<br />Landscaping and lighting illustrative</p>
    </div>
  </section>

  <section class="bg-[#e9e3d7]" id="pricing">
    <div class="mx-auto grid max-w-[1400px] gap-12 px-6 py-24 md:grid-cols-2 md:gap-20 lg:px-10 lg:py-32">
      <div><p class="eyebrow mb-7 text-brass-2">05 / Clarity from the start</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.9] tracking-[-.03em]">A clearer path<br /><em>to your next home.</em></h2><p class="mt-8 max-w-[490px] leading-relaxed text-ink-3">Every backyard is different. A site review is the first step towards a real scope, approval pathway and quotation.</p></div>
      <div class="border-t border-ink pt-7">
        <p class="font-mono text-[11px] uppercase tracking-[.14em] text-ink-3">Indicative target price</p>
        <p class="mt-4 font-display text-[clamp(4.6rem,8vw,8rem)] leading-none">$150k<span class="align-top font-sans text-lg">*</span></p>
        <p class="mt-5 max-w-[530px] text-lg leading-relaxed">Our current planning target is around $150,000 for a standard site.</p>
        <div class="mt-9 grid gap-7 border-t border-ink/20 pt-7 sm:grid-cols-2">
          <div><p class="font-mono text-[10px] uppercase tracking-[.13em] text-brass-2">Planned to include</p><ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-2"><li>GST and a standard foundation</li><li>Approvals and freight</li><li>Local installation</li><li>Most water and power connections</li></ul></div>
          <div><p class="font-mono text-[10px] uppercase tracking-[.13em] text-brass-2">Quoted separately</p><ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-2"><li>2 m × 4 m timber deck</li><li>Awning and accessories</li><li>Site-specific work outside the standard scope</li></ul></div>
        </div>
        <p class="mt-7 text-sm leading-relaxed text-ink-3">*Indicative only. Not a fixed price or offer. Ground conditions, access, connection distances and council requirements can change the final quotation. The exact inclusion schedule will be confirmed before sale.</p>
        <a href="#enquire" class="mt-8 inline-block border-b border-ink pb-2 font-mono text-[11px] uppercase tracking-[.14em]">Request a site review ↗</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-24 lg:px-10 lg:py-36" id="process"><div class="grid gap-10 md:grid-cols-2"><div><p class="eyebrow mb-7 text-brass-2">06 / From interest to installation</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.9] tracking-[-.03em]">A process<br /><em>with purpose.</em></h2></div><p class="max-w-[480px] self-end leading-relaxed text-ink-3">Much of the home is prepared before it reaches your block. Local professionals still need to assess the property, secure approvals where required, prepare the site, connect services and complete inspections.</p></div><div class="mt-16 grid border-t border-line md:grid-cols-4">{steps.map((step) => <div class="border-b border-line py-8 md:border-r md:px-6 md:first:pl-0 md:last:border-r-0"><span class="font-mono text-[11px] text-brass-2">{step[0]}</span><h3 class="mt-6 font-display text-3xl leading-none">{step[1]}</h3><p class="mt-5 text-sm leading-relaxed text-ink-3">{step[2]}</p></div>)}</div></section>

  <section class="bg-[#e9e3d7]" id="faq"><div class="mx-auto grid max-w-[1400px] gap-12 px-6 py-24 md:grid-cols-[.8fr_1.2fr] lg:px-10 lg:py-32"><div><p class="eyebrow mb-7 text-brass-2">07 / Good questions</p><h2 class="font-display text-[clamp(3.5rem,6vw,6.5rem)] leading-[.9] tracking-[-.03em]">Know more.<br /><em>Decide well.</em></h2><p class="mt-7 max-w-[390px] text-sm leading-relaxed text-ink-3">Queensland rules vary by block and council. See the <a class="underline underline-offset-4" href="https://www.planning.qld.gov.au/planning-issues-and-interests/granny-flats" target="_blank" rel="noopener noreferrer">Queensland Government guidance</a> for the state-level framework.</p></div><div class="border-t border-ink">{faqs.map((item) => <details class="group border-b border-ink/20 py-6"><summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-sans text-lg font-medium leading-snug md:text-xl">{item[0]}<span class="font-light text-2xl transition-transform group-open:rotate-45">+</span></summary><p class="max-w-[650px] pt-5 text-sm leading-relaxed text-ink-3 md:text-base">{item[1]}</p></details>)}</div></div></section>

  <section class="bg-ink text-bone" id="enquire">
    <div class="mx-auto grid max-w-[1400px] gap-12 px-6 py-24 md:grid-cols-[1.1fr_.9fr] md:gap-20 lg:px-10 lg:py-32">
      <div><p class="mb-7 font-mono text-[11px] uppercase tracking-[.16em] text-[#caa77b]">Start with your site</p><h2 class="font-display text-[clamp(4rem,7vw,7.8rem)] leading-[.86] tracking-[-.03em]">Could this be<br /><em>your backyard?</em></h2><p class="mt-8 max-w-[500px] text-lg leading-relaxed text-bone/70">Tell us where you’re thinking of building and how you’d use the space. A site review is the right first conversation.</p></div>
      <form id="site-review-form" name="site-review" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="self-end border-t border-bone/30 pt-7" aria-label="Site review enquiry">
        <input type="hidden" name="form-name" value="site-review" />
        <p class="hidden" aria-hidden="true"><label>Leave this field empty <input type="text" name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <p class="mb-7 font-mono text-[11px] uppercase tracking-[.14em] text-bone/60">Site review enquiry</p>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="block text-sm text-bone/80">Your name<input name="name" type="text" autocomplete="name" required class="mt-2 block w-full rounded-none border-b border-bone/50 bg-transparent px-0 py-3 text-base text-bone outline-none placeholder:text-bone/35 focus:border-[#d4ae79]" placeholder="Your name" /></label>
          <label class="block text-sm text-bone/80">Email address<input name="email" type="email" autocomplete="email" required class="mt-2 block w-full rounded-none border-b border-bone/50 bg-transparent px-0 py-3 text-base text-bone outline-none placeholder:text-bone/35 focus:border-[#d4ae79]" placeholder="you@example.com" /></label>
          <label class="block text-sm text-bone/80">Suburb or postcode<input name="suburb" type="text" autocomplete="address-level2" required class="mt-2 block w-full rounded-none border-b border-bone/50 bg-transparent px-0 py-3 text-base text-bone outline-none placeholder:text-bone/35 focus:border-[#d4ae79]" placeholder="Queensland suburb" /></label>
          <label class="block text-sm text-bone/80">What is it for?<select name="use" required class="mt-2 block w-full rounded-none border-b border-bone/50 bg-ink px-0 py-3 text-base text-bone outline-none focus:border-[#d4ae79]"><option value="" disabled selected>Select one</option><option>Family</option><option>Adult child</option><option>Long-term rental</option><option>Other</option></select></label>
        </div>
        <label class="mt-6 block text-sm text-bone/80">Anything you’d like us to know? <span class="text-bone/50">(optional)</span><textarea name="message" rows="3" maxlength="2000" class="mt-2 block w-full resize-y rounded-none border-b border-bone/50 bg-transparent px-0 py-3 text-base text-bone outline-none placeholder:text-bone/35 focus:border-[#d4ae79]" placeholder="Tell us what you have in mind"></textarea></label>
        <button type="submit" class="mt-9 w-full border border-bone px-6 py-4 text-left font-mono text-[11px] uppercase tracking-[.14em] transition-colors hover:bg-bone hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#d4ae79]">Request a site review <span class="float-right">↗</span></button>
        <p class="mt-4 text-xs leading-relaxed text-bone/55">We use your details to respond to this enquiry. Submissions are handled through Netlify Forms. Read our <a href="/privacy/" class="underline underline-offset-2 hover:text-bone">privacy notice</a>.</p>
        <p id="form-status" class="mt-4 hidden text-sm leading-relaxed text-[#e3bd86]" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</PageLayout>

<script>
  const form = document.getElementById("site-review-form");
  if (location.hostname === "localhost" || location.hostname === "127.0.0.1") {
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = document.getElementById("form-status");
      if (status) {
        status.classList.remove("hidden");
        status.textContent = "This form saves enquiries on the published Netlify site. Local previews do not send data.";
      }
    });
  }
</script>
